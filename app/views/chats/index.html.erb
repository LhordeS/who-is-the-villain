
<h1>Hall of Judgment</h1>

<div>
  <%= link_to "New Confession", new_deed_path %>
</div>

<% if @chats.any? %>
  <ul>
    <% @chats.each do |chat| %>
      <% next unless chat.deed %>
      <li>
        <%= link_to chat_path(chat) do %>
          <strong><%= chat.deed.title %></strong> —
          Verdict: <%= chat.deed.ai_verdict %> |
          Score: <%= chat.deed.villain_score == -1 ? "Flagged" : chat.deed.villain_score %>
          <br />
          <small><%= chat.deed.summary %></small>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No deeds have been judged yet. Are you completely innocent?</p>
<% end %>
