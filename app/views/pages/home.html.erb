<div class="main-container">
  <div class="hero-card">
    <h1 class="hero-card__title">Are you a saint or a total disaster?</h1>
    <p class="hero-card__description">Submit your most questionalbe life choices, get an instant verdict
      from our AI chatbot, and let the community vote on your conscience.
    </p>
    <div class="hero-card__actions">
      <%= link_to "Post a Deed", new_deed_path, class: "hero-card__action-link hero-card__action-link--primary" %>
      <%= link_to "Browse Other Deeds", deeds_path, class: "hero-card__action-link hero-card__action-link--secondary" %>
    </div>
  </div>

  <div class="trending-section">
    <h2 class="trending-section__header">Trending Villainies</h2>
    <div class="trending-section__container">
      <div class="deeds-grid">
        <% @deeds.each do |deed| %>
          <%= render 'shared/deed_cards', deed: deed %>
        <% end %>
      </div>
    </div>
  </div>
</div>
