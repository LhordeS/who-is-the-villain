<div class="container">
  <div class="card">
    <h1>Are you a saint or a total disaster?</h1>
    <p>Submit your most questionalbe life choices, get an instant verdict
      from our AI chatbot, and let the community vote on your conscience.
    </p>
    <%= link_to "Post a Deed", new_deed_path, class: "text-decoration-none text-dark" %>
    <%= link_to "Browse Other Deeds", deeds_path, class: "text-decoration-none text-dark" %>
  </div>
  <div>
    <h2>Treading Villainies</h2>
  </div>
  <div class="container bg-secondary-subtle">
    <% @deeds.each do |deed| %>
      <%= link_to deed_path(deed), class: "text-decoration-none text-dark" do %>
        <div class="card mb-3" style="width: 80%;">
          <div class="row g-0">
            <div class="col-md-4">
              <img src="..." class="img-fluid rounded-start" alt="...">
            </div>
            <div class="col-md-8">
              <div class="card-body">
                <h5 class="card-title"><%= deed.title %></h5>
                <p class="card-text"><%= deed.content %></p>
                <%= link_to "Villain (#{deed.get_upvotes.size})", upvote_deed_path(deed), data: { turbo_method: :post} %>
                <%= link_to "Saint (#{deed.get_downvotes.size})", downvote_deed_path(deed), data: { turbo_method: :post} %>
                <p class="card-text"><small class="text-body-secondary">Last updated 3 mins ago</small></p>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
