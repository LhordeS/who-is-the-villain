<div class="container">
<div class="card">

  <%# Verdict badge %>
  <div class="verdict__badge verdict__badge--<%= @deed.ai_verdict.to_s.parameterize %>">
    <%= @deed.ai_verdict %>
  </div>

  <%# Score bar %>
  <% score = @deed.villain_score.to_i %>
  <% score_pct = score == -1 ? 0 : score %>

  <p class="form-label" style="margin-top: 16px;">
    Villain score
    <span class="verdict__score" style="float:right; color: #F23022;">
      <%= score == -1 ? "Flagged" : "#{score}/100" %>
    </span>
  </p>

    <%= @deed.summary %>
    <div class="d-flex">
    <%= link_to "👹 Villain (#{deed.votes_for.up.where(vote_scope: nil).size})", upvote_deed_path(deed), data: { turbo_method: :post} %>
    <%= link_to "😇 Saint (#{deed.votes_for.down.where(vote_scope: nil).size})", downvote_deed_path(deed), data: { turbo_method: :post} %>
    <%= link_to "🤥 bs (#{deed.get_upvotes(vote_scope: 'flag').size})", flag_deed_path(deed), data: { turbo_method: :post } %>
    </div>
  </p>

</div>

  <%# only show chat if @deed.user_id == current_user %>
  <% if user_signed_in? && @deed.user == current_user %>
    <%= render "deeds/chat", deed: @deed, message: @message %>
  <% end %>
</div>
