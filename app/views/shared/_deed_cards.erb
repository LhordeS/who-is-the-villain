<div id="<%= dom_id(deed) %>">
  <div class="card deed-card mb-3" style="width: 80%;">
    <% if deed.user == current_user %>
      <%= link_to "X", deed_path(deed),
      class: "btn btn-sm position-absolute top-0 end-0 m-2 delete-link",
      data: { turbo_method: :delete } %>
    <% end %>
    <div class="row g-0">
      <div class="col-md-8">
        <div class="card-body">
          <div class="d-flex mb-1 align-items-center">
            <% if deed.user.avatar.attached? %>
              <%= cl_image_tag deed.user.avatar.key, alt: "avatar", class: "avatar-bordered" %>
            <% else %>
              <i class="fa-regular fa-circle-user fa-2xl"></i>
            <% end %>
            <p class="m-0">hello</p>
          </div>
          <h5 class="card-title mt-2"><%= deed.title %></h5>
          <p class="card-text mb-2"><%= deed.content %></p>
          <div class="d-flex" id="<%= dom_id(deed, :votes) %>">
            <%= link_to "👹 Villain #{deed.votes_for.up.where(vote_scope: nil).size}", upvote_deed_path(deed), data: { turbo_method: :post}, class: 'villain delete-link' %>
            <%= link_to "😇 Saint #{deed.votes_for.down.where(vote_scope: nil).size}", downvote_deed_path(deed), data: { turbo_method: :post}, class: 'saint delete-link' %>
            <%= link_to "🤥 bs #{deed.get_upvotes(vote_scope: 'flag').size}", flag_deed_path(deed), data: { turbo_method: :post }, class: 'bs delete-link' %>
          </div>
        </div>
      </div>
    </div>
    <%= link_to '', deed_path(deed), class: "card-link" %>
  </div>
</div>
