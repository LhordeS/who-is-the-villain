<%= link_to deed_path(deed), class: "text-decoration-none text-dark" do %>
  <div class="card deed-card mb-3" style="width: 80%;">
    <% if deed.user == current_user %>
      <%= button_to "X", deed_path(deed), method: :delete,
      form: { data: { controller: "stop-propagation", action: "click->stop-propagation#stop" } },
      class: "btn btn-sm position-absolute top-0 end-0 m-2",
      data: {turbo_confirm: "Delete #{deed.title}?"}%>
    <% end %>
    <div class="row g-0">
      <div class="col-md-4">
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <div class="d-flex flex-row mb-1">
            <i class="fa-solid fa-skull border border-dark rounded-circle p-3"></i>
            <% if deed.user == current_user %>
              <p class="card-text pl-3 pt-3"><%= "You" %></p>
            <% else %>
              <p class="card-text pl-3 pt-3"><%= "Anonymous Villain" %></p>
            <% end %>
          </div>
          <h5 class="card-title"><%= deed.title %></h5>
          <p class="card-text mb-2"><%= deed.content %></p>
          <div class="d-flex">
            <%= link_to "👹 Villain (#{deed.votes_for.up.where(vote_scope: nil).size})", upvote_deed_path(deed), data: { turbo_method: :post}, class: 'villain' %>
            <%= link_to "😇 Saint (#{deed.votes_for.down.where(vote_scope: nil).size})", downvote_deed_path(deed), data: { turbo_method: :post}, class: 'saint' %>
            <%= link_to "🤥 bs (#{deed.get_upvotes(vote_scope: 'flag').size})", flag_deed_path(deed), data: { turbo_method: :post }, class: 'bs' %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
