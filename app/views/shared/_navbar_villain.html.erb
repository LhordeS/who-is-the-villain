<div class="navbar navbar-expand-sm navbar-light navbar-lewagon border">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">
      <h2>Am I the Villain</h2>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse d-flex justify-content-between bg-red" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto">
        <li class="nav-item active">
          <%= link_to "Home", "/#", class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Deeds", "/deeds", class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Leaderboard", "/leaderboard", class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= simple_form_for :search, url: deeds_path, method: :get do |f| %>
            <div class="search-form-control form-group">
            <%= f.input :query, label: false, class: 'form-control string required', placeholder: 'Search' %>
            <% f.button :submit, 'search', class: 'btn btn-flat' %>
              <%# <i class="fas fa-search"></i> Search %>
            </div>
          <% end %>
        </li class="nav-item">
        <li class="nav-item dropdown">
          <img class="avatar dropdown-toggle" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" src="https://kitt.lewagon.com/placeholder/users/ssaunier" />
          <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
            <% if current_user %>
              <%= link_to "Post", "/deeds/new", class: "dropdown-item" %>
              <%= link_to "Dashboard", "/dashboard", class: "dropdown-item" %>
              <%= link_to 'Log Out', "/users/sign_out", class: "dropdown-item", data: { turbo_method: 'delete' } %>
            <% else %>
              <%= link_to 'Log in', "/users/sign_in", class: "dropdown-item" %>
            <% end %>
          </div>
        </li>
        <!--li class="nav-item"-->
        <!--/li-->
      </ul>
      <ul class="search">
      </ul>
    </div>
  </div>
</div>
