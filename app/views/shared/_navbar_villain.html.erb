<nav class="navbar navbar-expand-sm navbar-light navbar-villain">
  <div class="container-fluid">
    <%= link_to root_path, class: "navbar-brand villain-brand" do %>
      Am I the Villain?
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link #{current_page?(root_path) ? 'active' : ''}" %>
        </li>
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Post", new_deed_path, class: "nav-link #{current_page?(new_deed_path) ? 'active' : ''}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Dashboard", dashboard_path, class: "nav-link #{current_page?(dashboard_path) ? 'active' : ''}" %>
          </li>
        <% end %>
        <li class="nav-item">
          <%= link_to "Leaderboard", leaderboard_path, class: "nav-link #{current_page?(leaderboard_path) ? 'active' : ''}" %>
        </li>
      </ul>

      <div class="navbar-right d-flex align-items-center gap-3">
        <%= form_with url: deeds_path, method: :get, class: "villain-search-form" do |f| %>
          <div class="villain-search-wrapper">
            <i class="fa-solid fa-bars villain-search-icon"></i>
            <%= f.text_field :query, placeholder: "Search deeds", class: "villain-search-input" %>
            <button type="submit" class="villain-search-btn">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
        <% end %>

        <i class="fa-regular fa-bell villain-bell"></i>

        <% if user_signed_in? %>
          <div class="dropdown">
            <img class="villain-avatar dropdown-toggle" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
              src="https://kitt.lewagon.com/placeholder/users/ssaunier" alt="profile" />
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <%= link_to "Dashboard", dashboard_path, class: "dropdown-item" %>
              <%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: "delete" }, class: "dropdown-item" %>
            </div>
          </div>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "nav-link" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
