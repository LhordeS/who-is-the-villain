<%= simple_form_for [deed, message], html:{data: {
      controller: "submit-on-enter"}} do |f| %>
  <%= f.input :content,
  placeholder: "Ask a question",
  required: true,
  label: false,
  input_html: {
    data: {
      action: "keydown->submit-on-enter#submit"
    }
  }
  %>
  <%= f.button :submit, 'Judge Me', class: 'btn btn-primary' %>
<% end %>
